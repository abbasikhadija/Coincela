{
  "name": "coincela",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "benchmark": "npm run benchmark -w @coincela/api",
    "dev": "concurrently -k \"npm run dev -w @coincela/api\" \"npm run dev -w @coincela/web\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "test": "npm run test --workspaces",
    "test:integration": "npm run test:integration -w @coincela/api",
    "test:e2e": "playwright test",
    "db:migrate": "npm run db:migrate -w @coincela/api",
    "db:rollback": "npm run db:rollback -w @coincela/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
